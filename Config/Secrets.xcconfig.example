// Copy to Config/Secrets.xcconfig. This file is intentionally ignored by Git.
// xcconfig treats // as a comment, so URLs use the standard $()/ escape.
AVIATION_PROXY_BASE_URL = https:/$()/your-airport-xr-proxy.example.workers.dev
CLOUD_VISION_PROXY_BASE_URL = https:/$()/your-airport-xr-proxy.example.workers.dev
